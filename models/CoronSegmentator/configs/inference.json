{
    "bundle_root": "./",
    "ckpt_dir": "$@bundle_root + 'models'",
    "output_dir": "$@bundle_root + 'Output'",
    "output_ext": ".usd",
    "input_file": "Input/E_CT_0000.nii.gz",
    "infer": {
        "_target_": "scripts.heart_digital_twin.CoroSegmentator_Pipeline",
        "input_params": {
            "inputFile": "$@input_file",
            "outputDir": "$@output_dir"
        }
    },
    "run": [
        "$@infer.run()"
    ]
}
